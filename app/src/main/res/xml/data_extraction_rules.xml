<?xml version="1.0" encoding="utf-8"?>
<!--
    Room の記録は MediaStore の content URI を参照しており、別端末ではその URI が別の画像を指すか存在しない。
    DB だけが移ると記録と原本が食い違うため、クラウドバックアップ・端末間移行のどちらにも含めない。
    （Android 12 以降は allowBackup="false" でも端末間移行は止まらない）
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
